# InChat — backend environment template (ENGINEERING.md §11–12, DEVOPS.md §6).
# Copy to server/.env.local and adjust. NEVER commit real values.

# Environment bundle: dev | staging | prod
APP_ENV=dev

# HTTP
APP_HTTP_PORT=8080
APP_HTTP_READ_HEADER_TIMEOUT=5s
APP_SHUTDOWN_TIMEOUT=15s

# PostgreSQL (runtime role)
APP_PG_DSN=postgres://app:app_password@localhost:5432/inchat?sslmode=disable
APP_PG_MAX_CONNS=10

# Redis
APP_REDIS_ADDR=localhost:6379
APP_REDIS_PASSWORD=
APP_REDIS_DB=0

# Auth — access/refresh tokens (ARCHITECTURE.md §10.2, SECURITY_SPEC.md)
# Ed25519 seed, base64. Leave empty in dev for an ephemeral key; REQUIRED in
# staging/prod. Generate with: openssl rand -base64 32
APP_JWT_PRIVATE_KEY=
APP_JWT_ISSUER=https://api.socialmedia.example
APP_JWT_AUDIENCE=inchat-api
APP_ACCESS_TOKEN_TTL=15m
APP_REFRESH_TOKEN_TTL=720h

# Auth — Argon2id password KDF (SECURITY_SPEC.md PASS-1; memory in KiB)
APP_ARGON2_MEMORY_KIB=65536
APP_ARGON2_TIME=3
APP_ARGON2_THREADS=4

# idgen node id (0-1023). Distinct per instance in a deployment.
APP_IDGEN_NODE_ID=0
